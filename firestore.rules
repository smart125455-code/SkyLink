rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    // User documents: only the account owner can read/write their own profile document.
    match /users/{userId} {
      allow read: if verified() && request.auth.uid == userId;
      allow create: if verified() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.email == request.auth.token.email;
      allow update: if verified() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'photoURL', 'coverURL']);
      allow delete: if false;
    }

    // Starter feed: signed-in, verified members can read posts.
    match /posts/{postId} {
      allow read: if verified();
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'likes', 'comments', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.authorName is string
        && request.resource.data.likes == []
        && request.resource.data.comments == [];
      // Starter demo rules; production-grade likes/comments should use subcollections and stricter per-field validation.
      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments'])
        && request.resource.data.text == resource.data.text
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName;
      allow delete: if verified() && request.auth.uid == resource.data.authorUid;
    }
  }
}